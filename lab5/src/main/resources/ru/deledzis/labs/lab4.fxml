<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.172-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.deledzis.labs.lab4.Lab4Controller">
    <Label layoutX="199.0" layoutY="23.0" text="Лабораторная работа №4">
        <font>
            <Font name="Lato Black" size="18.0" />
        </font>
    </Label>
    <TextField fx:id="threadsCountText" layoutX="50.0" layoutY="65.0" prefHeight="30.0" prefWidth="140.0" promptText="Кол-во потоков">
        <font>
            <Font name="Lato Regular" size="14.0" />
        </font>
    </TextField>
    <TextField fx:id="linesCountText" layoutX="200.0" layoutY="65.0" prefHeight="30.0" prefWidth="140.0" promptText="Кол-во строк">
        <font>
            <Font name="Lato Regular" size="14.0" />
        </font>
    </TextField>
    <Button fx:id="runButton" disable="true" layoutX="440.0" layoutY="65.0" mnemonicParsing="false" onAction="#onRunButtonClicked" prefHeight="30.0" prefWidth="110.0" text="Пуск" textAlignment="CENTER">
        <font>
            <Font name="Lato Regular" size="13.0" />
        </font></Button>
    <Button fx:id="backButton" cancelButton="true" layoutX="14.0" layoutY="9.0" mnemonicParsing="false" onAction="#onBackButtonClicked" text="←" textAlignment="CENTER">
        <font>
            <Font name="Lato Light Italic" size="14.0" />
        </font>
    </Button>
    <Line fx:id="errorThreadsCountLine" endX="130.0" endY="100.0" startX="50.0" startY="100.0" stroke="#d50000" visible="false" />
    <Label fx:id="errorThreadsCountDescriptionLabel" layoutX="50.0" layoutY="105.0" text="Укажите в качестве количества шагов целое число" textFill="#d50000" visible="false" />
    <Line fx:id="errorLinesCountLine" endX="220.0" endY="100.0" startX="140.0" startY="100.0" stroke="#d50000" visible="false" />
    <Label fx:id="errorLinesCountDescriptionLabel" layoutX="50.0" layoutY="105.0" text="Минимальное значение должно быть целым числом" textFill="#d50000" visible="false" />

    <TextArea fx:id="resultTextArea" editable="false" layoutX="50.0" layoutY="127.0" prefHeight="245.0" prefWidth="500.0" promptText="Здесь будет результат. Для начала работы, введите желаемое количество потоков и выводимых строк в соответствующие поля выше и нажмите кнопку &quot;Пуск&quot;">
        <font>
            <Font name="Lato Regular" size="14.0" />
        </font>
    </TextArea>
</AnchorPane>
