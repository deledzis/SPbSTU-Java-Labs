<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/8.0.172-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.deledzis.labs.lab2.Lab2Controller">
    <Label layoutX="149.0" layoutY="23.0" text="Лабораторная работа №2">
        <font>
            <Font name="Lato Black" size="18.0" />
        </font>
    </Label>
    <TextField fx:id="countText" layoutX="50.0" layoutY="65.0" prefHeight="30.0" prefWidth="100.0" promptText="Количество">
        <font>
            <Font name="Lato Regular" size="14.0" />
        </font>
    </TextField>
    <Button fx:id="printButton" disable="true" layoutX="170.0" layoutY="65.0" mnemonicParsing="false" onAction="#onPrintButtonClicked" prefHeight="30.0" text="Вывод" textAlignment="CENTER">
      <font>
         <Font name="Lato Regular" size="13.0" />
      </font></Button>
    <Button fx:id="backButton" cancelButton="true" layoutX="14.0" layoutY="9.0" mnemonicParsing="false" onAction="#onBackButtonClicked" text="←" textAlignment="CENTER">
        <font>
            <Font name="Lato Light Italic" size="14.0" />
        </font>
    </Button>
    <Line fx:id="errorLine" endX="150.0" endY="100.0" startX="50.0" startY="100.0" stroke="#d50000" visible="false" />
    <Label fx:id="errorDescriptionLabel" layoutX="50.0" layoutY="105.0" text="Укажите в качестве количества целое число" textFill="#d50000" visible="false" />
   <TextArea fx:id="resultTextArea" editable="false" layoutX="50.0" layoutY="127.0" prefHeight="245.0" prefWidth="400.0" promptText="Здесь будет результат. Для начала работы, введите желаемое количество объектов в поле выше и нажмите кнопку &quot;Вывод&quot;" wrapText="true">
      <font>
         <Font name="Lato Regular" size="14.0" />
      </font></TextArea>
</AnchorPane>
