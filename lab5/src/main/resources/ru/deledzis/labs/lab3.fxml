<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/8.0.172-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.deledzis.labs.lab3.Lab3Controller">
    <Label layoutX="149.0" layoutY="23.0" text="Лабораторная работа №3">
        <font>
            <Font name="Lato Black" size="18.0" />
        </font>
    </Label>
    <TextField fx:id="stepsText" layoutX="50.0" layoutY="65.0" prefHeight="30.0" prefWidth="80.0" promptText="Шаги">
        <font>
            <Font name="Lato Regular" size="14.0" />
        </font>
    </TextField>
    <TextField fx:id="minValueText" layoutX="140.0" layoutY="65.0" prefHeight="30.0" prefWidth="80.0" promptText="Минимальное значение">
        <font>
            <Font name="Lato Regular" size="14.0" />
        </font>
    </TextField>
    <TextField fx:id="maxValueText" layoutX="230.0" layoutY="65.0" prefHeight="30.0" prefWidth="80.0" promptText="Максимальное значение">
        <font>
            <Font name="Lato Regular" size="14.0" />
        </font>
    </TextField>
    <Button fx:id="runButton" disable="true" layoutX="340.0" layoutY="65.0" mnemonicParsing="false" onAction="#onRunButtonClicked" prefHeight="30.0" prefWidth="110.0" text="Пуск" textAlignment="CENTER">
        <font>
            <Font name="Lato Regular" size="13.0" />
        </font></Button>
    <Button fx:id="backButton" cancelButton="true" layoutX="14.0" layoutY="9.0" mnemonicParsing="false" onAction="#onBackButtonClicked" text="←" textAlignment="CENTER">
        <font>
            <Font name="Lato Light Italic" size="14.0" />
        </font>
    </Button>
    <Line fx:id="errorStepsLine" endX="130.0" endY="100.0" startX="50.0" startY="100.0" stroke="#d50000" visible="false" />
    <Label fx:id="errorStepsDescriptionLabel" layoutX="50.0" layoutY="105.0" text="Укажите в качестве количества шагов целое число" textFill="#d50000" visible="false" />
    <Line fx:id="errorMinLine" endX="220.0" endY="100.0" startX="140.0" startY="100.0" stroke="#d50000" visible="false" />
    <Label fx:id="errorMinDescriptionLabel" layoutX="50.0" layoutY="105.0" text="Минимальное значение должно быть целым числом" textFill="#d50000" visible="false" />
    <Line fx:id="errorMaxLine" endX="310.0" endY="100.0" startX="230.0" startY="100.0" stroke="#d50000" visible="false" />
    <Label fx:id="errorMaxDescriptionLabel" layoutX="50.0" layoutY="105.0" text="Максимальное значение должно быть целым числом" textFill="#d50000" visible="false" />

    <TextArea fx:id="resultTextArea" editable="false" layoutX="50.0" layoutY="127.0" prefHeight="245.0" prefWidth="400.0" promptText="Здесь будет результат. Для начала работы, введите желаемое количество шагов, минимальное и максимальное генерируемое значение в поля выше и нажмите кнопку &quot;Пуск&quot;" wrapText="true">
        <font>
            <Font name="Lato Regular" size="14.0" />
        </font>
    </TextArea>
</AnchorPane>
